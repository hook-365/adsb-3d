# The minimum ADS-B 3D needs. Copy this to .env and fill it in.
#
# Every other setting is optional and lives in docker-compose.example.yml,
# the one example for the whole stack (see docs/CONFIGURATION.md).

# Where your receiver is. Altitude is in feet MSL.
LATITUDE=45.0000
LONGITUDE=-90.0000
ALTITUDE=1000
LOCATION_NAME=My Station

# Your feeder: anything that serves readsb's /data/aircraft.json. Use its
# IP and port, or its service name (http://ultrafeeder) if it is on the
# same Docker network as adsb-3d.
FEEDER_URL=http://192.0.2.50:8080

# Your email, or a site where you can be reached. Sent in the User-Agent
# of route lookups to adsb.im so they can reach you if your instance
# misbehaves. Never shown to viewers. Routes stay off until this is a real
# address, so change it.
ROUTE_API_CONTACT=you@example.com

# Only for historical playback or ACARS: the database password, shared by
# track-service, acars-service and the database.
# DB_PASSWORD=change-me-to-a-strong-password
