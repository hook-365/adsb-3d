# =============================================================================
# ADS-B 3D — Environment Variable Reference
# =============================================================================
# Every environment variable the stack understands, grouped by feature.
# Set the ones you need in the `environment:` block of your compose service
# (see docker-compose.example.yml for a working layout). Variables marked
# "(.env substitution)" are read by docker compose from this file directly.
#
# A basic live-only deployment needs only the REQUIRED section below.
# Everything else is optional and disabled by default.

# -----------------------------------------------------------------------------
# REQUIRED — your station + feeder
# -----------------------------------------------------------------------------
LATITUDE=45.0000               # receiver latitude  (decimal degrees)
LONGITUDE=-90.0000             # receiver longitude (decimal degrees)
ALTITUDE=1000                  # receiver altitude in feet
LOCATION_NAME=My Station       # shown in the UI

# Anything that serves a readsb-style /data/aircraft.json
# (ultrafeeder, tar1090, readsb, dump1090-fa, ...):
#   FEEDER_URL=http://ultrafeeder        # docker service name
#   FEEDER_URL=http://192.0.2.50:8080    # IP:port on your LAN
#   FEEDER_URL=https://adsb.example.com  # remote host
FEEDER_URL=http://ultrafeeder

# -----------------------------------------------------------------------------
# OPTIONAL — features (all off by default)
# -----------------------------------------------------------------------------
# Historical playback + 3D airway heatmap. Requires the track-service +
# timescaledb containers. Leave false until those are running, or the history
# UI will appear but every history request will fail.
ENABLE_HISTORICAL=false

# ACARS message decoding. Requires the acars-service container AND an external
# acarshub stack feeding it on TCP 15550 (see acars-service/README.md).
ENABLE_ACARS=false

# VHF voice scanner panel. Requires a separate voice-services stack
# (rtl_airband + Icecast + the voice-events sidecar; see docs/VOICE.md).
# The panel is a call feed — every radio transmission is a discrete clip —
# and only appears on the local feed in multi-feed deployments. When true,
# VOICE_STREAM_HOST and VOICE_EVENTS_HOST below are REQUIRED — the container
# refuses to start without them.
ENABLE_VOICE=false

# Deploy-level kill switch for 3D terrain (elevation tiles fetched from
# AWS Open Data, proxied + cached like the basemaps — no API key). Users
# still opt in per-browser via the settings panel; false removes the
# feature entirely.
ENABLE_TERRAIN=true

# Hide the home tower marker (privacy on public demos).
HIDE_TOWER=false

# Voice scanner upstream hosts — only used when ENABLE_VOICE=true:
# VOICE_EVENTS_HOST=voice-events:8001    # voice-events sidecar (host:port) —
#                                        # serves /voice/calls + /voice/ws; this
#                                        # is what the frontend actually uses
# VOICE_STREAM_HOST=voice-icecast:8000   # Icecast host (host:port) — required by
#                                        # nginx for the legacy /voice/scanner.mp3
#                                        # block; the frontend plays calls, not it

# -----------------------------------------------------------------------------
# OPTIONAL — multi-feed (a network of receivers, with an in-app feed picker)
# -----------------------------------------------------------------------------
# Slot 1 is THIS station (local). Slots 2+ are other adsb-3d instances reached
# over HTTP. Adding a remote feed = 4 vars: NAME, URL, LAT, LON — the entrypoint
# builds everything else. No JSON to hand-write.
#
# Slots must be numbered contiguously from 1 (FEED1, FEED2, FEED3 — no gaps);
# a gap stops parsing and the container will warn you.
#
# FEED_MODE is auto-synthesised (multi when 2+ feeds are defined, single
# otherwise) — leave it unset unless you deliberately want to force a mode.
#
#   FEED1_NAME=Home Station    # slot 1 is local; FEED1_URL is ignored
#   FEED1_LAT=45.0000
#   FEED1_LON=-90.0000
#   FEED1_ALT=1000             # feet MSL — every altitude in this file is feet
#
#   FEED2_NAME=Remote Site
#   FEED2_URL=192.0.2.10:8086  # host:port of another adsb-3d instance
#   FEED2_LAT=43.0000
#   FEED2_LON=-89.0000
#   FEED2_COLOR=#ff8c4c        # optional badge color
#   FEED2_ACARS=true           # optional, enable ACARS for this feed
#
# Advanced — when a remote feed's live-data source and track API are on
# different hosts (e.g. a tar1090 for data + a dedicated track-service),
# drop FEED{N}_URL and give an explicit pair instead:
#   FEED3_NAME=Remote Site B
#   FEED3_LAT=43.0000
#   FEED3_LON=-87.0000
#   FEED3_DATA_HOST=192.0.2.20:8080         # serves /data/aircraft.json
#   FEED3_API_HOST=track-service-feed3:8000 # serves the track API

# -----------------------------------------------------------------------------
# OPTIONAL — database (only for historical mode and/or ACARS)
# -----------------------------------------------------------------------------
# Shared by the track-service, acars-service, and timescaledb containers.
# Set DB_PASSWORD once here — docker-compose.example.yml feeds it to all three
# via .env substitution, so it can never drift out of sync.
# DB_PASSWORD=change-me-to-a-strong-password   # (.env substitution)
# DB_NAME=adsb_tracks
# DB_USER=adsb

# -----------------------------------------------------------------------------
# OPTIONAL — acars-service (only when running ACARS)
# -----------------------------------------------------------------------------
# ACARS_HOST=acarshub           # hostname/IP of your external acarshub stack
# ACARS_PORT=15550              # acarshub JSON TCP port
# STATION_ID=MY_STATION         # your station identifier

# -----------------------------------------------------------------------------
# ADVANCED — rarely needed; defaults are sensible
# -----------------------------------------------------------------------------
# BASE_PATH=/3d                 # reverse-proxy subpath (auto-detected normally)
# TRACK_API_HOST=track-service:8000    # nginx upstream for the track API
# ACARS_API_HOST=acars-service:8000    # nginx upstream for the ACARS API
# MAP_ZOOM=8                    # map tile pre-cache zoom level
# MAP_GRID_SIZE=21              # map tile pre-cache grid size
